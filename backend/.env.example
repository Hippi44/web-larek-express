AUTH_REFRESH_SECRET=dev-refresh-secret-please-change-123456
AUTH_ACCESS_TOKEN_EXPIRY=10m
AUTH_REFRESH_TOKEN_EXPIRY=7d
UPLOAD_MAX_SIZE=5242880
